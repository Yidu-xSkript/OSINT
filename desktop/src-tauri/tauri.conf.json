{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OSINT Graph",
  "version": "0.1.0",
  "identifier": "com.osintgraph.app",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OSINT Graph",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/osint-backend"]
  }
}
